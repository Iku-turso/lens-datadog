{
  "name": "@k8slens/datadog",
  "version": "0.1.1",
  "description": "See Datadog metrics, monitors and events for your Kubernetes resources in Lens, and jump to them on the Datadog website.",
  "keywords": [
    "lens-extension"
  ],
  "license": "MIT",
  "author": "Iku-turso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iku-turso/lens-datadog.git"
  },
  "bugs": {
    "url": "https://github.com/Iku-turso/lens-datadog/issues"
  },
  "homepage": "https://github.com/Iku-turso/lens-datadog#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
